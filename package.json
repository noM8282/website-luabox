{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx artifacts/api-server/src/index.ts",
    "build": "npm run build --workspaces --if-present",
    "start": "node artifacts/api-server/dist/index.mjs",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
